[Unit]
Description=Dantherm Control read-only RS485 gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=passivelink
Group=passivelink
SupplementaryGroups=dialout
WorkingDirectory=/opt/dantherm-passivelink
EnvironmentFile=/etc/dantherm-passivelink/gateway.env
ExecStart=/opt/dantherm-passivelink/venv/bin/python /opt/dantherm-passivelink/passivelink_gateway.py --device ${RS485_DEVICE} --bind ${GATEWAY_BIND} --port ${GATEWAY_PORT}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
