[Unit]
Description=Dantherm Control optional DS18B20 service
After=network-online.target sys-subsystem-w1-devices.device
Wants=network-online.target

[Service]
Type=simple
User=passivelink
Group=passivelink
SupplementaryGroups=video
WorkingDirectory=/opt/dantherm-passivelink
ExecStart=/usr/bin/python3 /opt/dantherm-passivelink/onewire_temperature_server.py --config /etc/dantherm-passivelink/onewire.json --bind 0.0.0.0 --port 4197
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
